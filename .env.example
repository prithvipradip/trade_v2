# IBKR TWS/Gateway connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# Polygon.io (free tier: 5 calls/min)
POLYGON_API_KEY=

# Finnhub (free tier: 60 calls/min)
FINNHUB_API_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paper or live. Live needs ALL of: config.yaml trading.mode: live, TRADING_MODE=live here, AIT_ALLOW_LIVE=1 here,
# and a live-account IB port (4001 / 7496). Anything else starts as paper; a paper start on a live port is refused.
TRADING_MODE=paper
# AIT_ALLOW_LIVE=1

# Market-data entitlement: 4 = delayed (paper default), 1 = live. Set only when the live data subscription is in place.
# AIT_MARKET_DATA_TYPE=4

# MLflow experiment tracking (local SQLite backend in data/)
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
