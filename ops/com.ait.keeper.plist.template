<?xml version="1.0" encoding="UTF-8"?>
<!-- W16 B1 (R25 plat-05). TEMPLATE — do not load this file directly.
     Run ops/install_launchd.sh, which substitutes __ROOT__/__PYTHON__ for this
     machine and installs the result. Paths are NOT baked into the repo: the
     Windows keeper hardcoded another user's home (C:\Users\prith\...), which is
     the mistake this template exists to avoid. -->
<plist version="1.0">
<dict>
    <key>Label</key>              <string>com.ait.keeper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/ops/keeper_ait.sh</string>
    </array>
    <key>WorkingDirectory</key>   <string>__ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>AIT_PYTHON</key>     <string>__PYTHON__</string>
        <key>PYTHONIOENCODING</key><string>utf-8</string>
    </dict>
    <!-- RunAtLoad + KeepAlive: survives logout, reboot, and the keeper itself
         dying. This is what replaces "a VS Code terminal someone might quit". -->
    <key>RunAtLoad</key>          <true/>
    <key>KeepAlive</key>          <true/>
    <key>StandardOutPath</key>    <string>__ROOT__/logs/launchd_keeper.log</string>
    <key>StandardErrorPath</key>  <string>__ROOT__/logs/launchd_keeper.log</string>
</dict>
</plist>
